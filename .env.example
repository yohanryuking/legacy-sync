# Copia este archivo a .env y ajusta valores para tu entorno local.

# Cadena de conexión a Postgres (Docker Compose la expone en localhost:5433 por defecto).
DATABASE_URL=postgresql+psycopg://legacy_sync:legacy_sync@localhost:5433/legacy_sync

# Cantidad de registros "sucios" a generar con `legacy-sync seed`.
SEED_RECORD_COUNT=2000

# Probabilidad (0-1) de que la carga de un registro falle de forma simulada
# (timeout de red, etc.) para poder ejercitar la cola de reintentos en Sprint 3.
SIMULATED_LOAD_FAILURE_RATE=0.03
